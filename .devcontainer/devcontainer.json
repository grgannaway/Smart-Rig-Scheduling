{
	"name": "Dev Container",
	"build": {
		"dockerfile": "../Dockerfile",
		"context": "..",
		"target": "development",
		"args": {
			"POETRY_HTTP_BASIC_ML_TOOLS_USERNAME": "${localEnv:POETRY_HTTP_BASIC_ML_TOOLS_USERNAME}",
			"POETRY_HTTP_BASIC_ML_TOOLS_PASSWORD": "${localEnv:POETRY_HTTP_BASIC_ML_TOOLS_PASSWORD}"
		}
	},
	"hostRequirements": {
		"cpus": 4,
		"memory": "8gb",
		"storage": "32gb"
	},
	// This line allows you to use Docker runconfigs if you set "sharedVolumes": false
	"mounts": [
		"source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind",
		"source=projectname-bashhistory,target=/commandhistory,type=volume"
	],
	// "initializeCommand": "docker login -u ${localEnv:ACR_CONTAINER_REGISTRY_USER} -p ${localEnv:ACR_CONTAINER_REGISTRY_PASSWORD} ${localEnv:ACR_CONTAINER_REGISTRY_SERVER}",
	"postCreateCommand": "docker buildx create --use",
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/github-cli": {
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/azure-cli": {
			"version": "latest"
		}
	},
	"containerEnv": {
		"WORKSPACE_PATH": "${containerWorkspaceFolder}/",
		"DAGSTER_HOME": "${containerWorkspaceFolder}/.dagster_home",
		"HISTFILE": "/commandhistory/.bash_history"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"github.copilot",
				"github.copilot-chat",
				"github.vscode-github-actions",
				"github.vscode-pull-request-github",
				"ms-azuretools.vscode-docker",
				"ms-toolsai.jupyter",
				"ms-vscode-remote.vscode-remote-extensionpack",
				"charliermarsh.ruff",
				"mutantdino.resourcemonitor",
				"redhat.vscode-yaml",
				"tamasfe.even-better-toml",
				"xyz.local-history"
			]
		}
	}
}
